# Clerk publishable key. Browser. Set in .env.local and on Vercel.
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key. Server only. Set in .env.local and on Vercel. Never expose it to the browser.
CLERK_SECRET_KEY=
# Optional. Comma-separated origins allowed to call the API, for example http://localhost:5173,https://your-app.vercel.app
CLERK_AUTHORIZED_PARTIES=
# Supabase project URL. Optional. Set together with SUPABASE_ANON_KEY, or leave both empty.
SUPABASE_URL=
# Supabase anon key. Optional. Public by design. Set together with SUPABASE_URL, or leave both empty.
SUPABASE_ANON_KEY=
# Groq API key for Fix with AI. Server only. Set on Vercel. Never put it in the browser bundle.
GROQ_API_KEY=
