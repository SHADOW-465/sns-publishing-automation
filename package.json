{
  "name": "automation-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p . && vite build",
    "preview": "vite preview",
    "sample": "node --import ./test/setup.ts test/run-sample.ts samples-local/out",
    "sample:pdf": "node --import ./test/setup.ts test/run-pdf-sample.ts samples-local/out-pdf",
    "epubcheck": "node test/epubcheck.ts",
    "test": "node --test --import ./test/setup.ts \"test/**/*.test.ts\""
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
